<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_pipeline</name>
  <version>0.0.0</version>
  <description>Collection of launch files for vision-related nodes</description>
  <maintainer email="todo@todo.com">todo</maintainer>
  <license>todo</license>

  <!-- Bumblebee's Packages -->
  <exec_depend>aruco_loco</exec_depend>
  <exec_depend>depth_anything_ros2_trt</exec_depend>
  <exec_depend>image_matching</exec_depend>
  <exec_depend>image_processing</exec_depend>
  <exec_depend>pose_estimator</exec_depend>
  <exec_depend>yolo_ros_trt</exec_depend>

  <depend>rosidl_default_generators</depend>
  <depend>rosidl_default_runtime</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>gscam</exec_depend>
  <exec_depend>isaac_ros_image_proc</exec_depend>
  <exec_depend version_gte="5.1.8">image_transport</exec_depend>
  <exec_depend version_gte="5.0.13">image_proc</exec_depend>
  <exec_depend version_gte="4.0.7">compressed_image_transport</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
